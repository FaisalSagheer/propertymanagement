# PropertyPro Environment Variables
# Copy to .env.local (or .env) and fill in real values. Never commit the real file.

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/propertypro
# Self-Hosted MongoDB
# MONGODB_URI=mongodb://mongo:password@your_ip_address:27017/propertypro?authSource=admin
# MONGODB_DB=propertypro

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret
# Auth.js v5 requires this to trust localhost
AUTH_TRUST_HOST=true
# Alternative: specify the exact URL
AUTH_URL=http://localhost:3001

# Cloudflare R2 (keys from https://dash.cloudflare.com)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-custom-domain.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-custom-domain.com

# Stripe Configuration (keys from https://dashboard.stripe.com)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Email Configuration (SMTP)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-email-password
EMAIL_FROM=your-email@gmail.com

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Application Configuration (optional)
APP_NAME=propertypro
APP_URL=http://localhost:3001
SUPPORT_EMAIL=support@propertpro.com

# Cron endpoints (e.g. /api/cron/check-leases) refuse to run without this.
# Callers must send: Authorization: Bearer <CRON_SECRET>. Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Seed / demo / debug API routes answer 404 in production. Only enable them on a
# throwaway environment, never against real data.
# ENABLE_DEMO_ROUTES=true

# One-time first-admin setup (POST /api/setup/create-admin). Set a long random
# value (openssl rand -hex 32) ONLY while creating the first admin, then remove
# it. Sent as the x-setup-token header. Unset = the route is off.
# SETUP_TOKEN=

# New passwords are checked against Have I Been Pwned (only the first 5 characters of
# the password's SHA-1 hash are sent). Set to true to skip that online check.
# DISABLE_BREACHED_PASSWORD_CHECK=true
